<Window x:Class="ModReverse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="3Dmigoto Mod Reverse"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0D"
        Foreground="#F3F3F3"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Background" Value="#2A2A2D" />
            <Setter Property="BorderBrush" Value="#38383C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#343438" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#69696F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D42" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Background" Value="#1C1C1F" />
            <Setter Property="BorderBrush" Value="#37373B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="#F3F3F3" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Background" Value="#242427" />
            <Setter Property="BorderBrush" Value="#414146" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E8" />
            <Setter Property="Margin" Value="0,0,22,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0F0F11"
                BorderBrush="#202023"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="MR"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#E47C74" />
                <StackPanel Grid.Row="1" Margin="10,22">
                    <Border Height="48" Background="#27272B" CornerRadius="6">
                        <Grid>
                            <Border Width="4"
                                    HorizontalAlignment="Left"
                                    Background="#CF7169"
                                    CornerRadius="2" />
                            <TextBlock Text="🔑"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20" />
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Text="⚙"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           Foreground="#A9A9AD" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0D0D0F"
                    BorderBrush="#202023"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock Text="文件"
                               VerticalAlignment="Center"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#AFAFB4"
                                   Text="游戏格式" />
                        <ComboBox ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding SelectedGame}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="30,24,30,30"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="24"
                            Background="#151517"
                            BorderBrush="#242427"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="一键逆向"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,22"
                                       Foreground="#9D9DA3"
                                       Text="从 3Dmigoto / XXMI / WWMI 的 INI 与缓冲资源还原可导入模型。" />

                            <TextBlock Margin="0,0,0,7"
                                       Foreground="#C7C7CB"
                                       Text="模型 INI" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         IsReadOnly="True"
                                         Text="{Binding IniPath, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding BrowseIniCommand}"
                                        Content="选择 INI" />
                            </Grid>

                            <TextBlock Margin="0,18,0,7"
                                       Foreground="#C7C7CB"
                                       Text="输出目录" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         IsReadOnly="True"
                                         Text="{Binding OutputPath, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding BrowseOutputCommand}"
                                        Content="选择目录" />
                            </Grid>

                            <Border Margin="0,20,0,18"
                                    Padding="16,13"
                                    Background="#1D1D20"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="True"
                                              IsEnabled="False"
                                              Content="保留 DDS" />
                                    <CheckBox IsChecked="{Binding CreatePng}"
                                              Content="转换 PNG" />
                                    <CheckBox IsChecked="{Binding CreateJpg}"
                                              Content="同时生成 JPG" />
                                </StackPanel>
                            </Border>

                            <Button Margin="0,0,0,10"
                                    Command="{Binding ReverseSingleCommand}">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="一键逆向 Mod 的 INI" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#AFAFB5"
                                               Text="普通单模；WWMI 会按组件和 ShapeKey 正确拆分。" />
                                </StackPanel>
                            </Button>

                            <Button Margin="0,0,0,10"
                                    IsEnabled="False">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="一键逆向基于 Buffer 的分支 Mod 的 INI" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#AFAFB5"
                                               Text="待提供代表性样例后启用。" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ReverseDrawIndexedCommand}">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="一键逆向基于 DrawIndexed 的分支 Mod 的 INI" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#AFAFB5"
                                               Text="按照 count / first_index 裁剪、重映射并输出独立模型。" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="20"
                            Background="#151517"
                            BorderBrush="#242427"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="运行状态" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="#C9C9CD"
                                           Text="{Binding StatusText}" />
                            </Grid>
                            <ProgressBar Margin="0,12,0,12"
                                         Height="3"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Height="125"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
